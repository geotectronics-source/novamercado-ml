# Copie este archivo a .env y cambie las claves. El archivo .env NO se versiona.

# Base de datos PostgreSQL del producto (separada de la de Airflow)
APP_DB_NAME=novamercado
APP_DB_USER=novamercado
APP_DB_PASSWORD=cambie_esta_clave_app

# Base de datos de Airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambie_esta_clave_airflow

# Usuario administrador de Airflow (lo usa también la API para disparar el DAG)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambie_esta_clave_admin
AIRFLOW_SECRET_KEY=cambie_este_secreto_largo
# Opcional: clave Fernet para cifrar conexiones de Airflow
AIRFLOW_FERNET_KEY=

# Puertos publicados en el host (cámbielos si ya están ocupados). La API siempre usa 8000.
AIRFLOW_PUERTO_HOST=8080
MLFLOW_PUERTO_HOST=5000

# Criterio de reemplazo: mejora mínima de costo exigida al candidato (0.01 = 1 %)
MARGEN_REEMPLAZO=0.01
